  - m_Id: 255831535779840
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 264018280316928
    m_Localized: Beenden?
    m_Metadata:
      m_Items: []
  - m_Id: 264160769212416
    m_Localized: "M\xF6chtest du das Spiel wirklich beenden?"
    m_Metadata:
      m_Items: []
  - m_Id: 264212656947200
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 264250174996480
    m_Localized: Beenden
    m_Metadata:
      m_Items: []
  - m_Id: 267636408582144
    m_Localized: "L\xE4dt..."
    m_Metadata:
      m_Items: []
  - m_Id: 322286851719168
    m_Localized: "Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 322328677318656
    m_Localized: Nochmal versuchen
    m_Metadata:
      m_Items: []
  - m_Id: 322357261500416
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 322758924828672
    m_Localized: 'Punktzahl:'
    m_Metadata:
      m_Items: []
  - m_Id: 323006443290624
    m_Localized: Rekord
    m_Metadata:
      m_Items: []
  - m_Id: 324972066111488
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 323144184233984
    m_Localized: Alle Fortschritte gehen verloren.
    m_Metadata:
      m_Items: []
  - m_Id: 323276204146688
    m_Localized: Nochmal versuchen?
    m_Metadata:
      m_Items: []
  - m_Id: 323298245214208
    m_Localized: "Hauptmen\xFC?"
    m_Metadata:
      m_Items: []
  - m_Id: 322549373206528
    m_Localized: Erster Kontakt gescheitert. Tod bei Kollision.
    m_Metadata:
      m_Items: []
  - m_Id: 322383782084608
    m_Localized: Kein Boden erkannt. Fallen im Weltraum.
    m_Metadata:
      m_Items: []
  - m_Id: 335795706658816
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 604724567998464
    m_Localized: Neige dein Handy um dich zu bewegen.
    m_Metadata:
      m_Items: []
  - m_Id: 180702060588564480
    m_Localized: "Schie\xDFe, booste durch, springe oder weiche UFOs aus."
    m_Metadata:
      m_Items: []
  - m_Id: 604853593178112
    m_Localized: Sammle Treibstoff, um deinen Boost aufzuladen.
    m_Metadata:
      m_Items: []
  - m_Id: 604892465987584
    m_Localized: <color=#EC1321>Rote <color=#FFFFFF>Plattformen zerbrechen nach einmaliger
      Nutzung.
    m_Metadata:
      m_Items: []
  - m_Id: 604938443948032
    m_Localized: <color=#BE23FE>Lila <color=#FFFFFF>Plattformen bewegen sich links
      und rechts.
    m_Metadata:
      m_Items: []
  - m_Id: 4223074929999872
    m_Localized: Start-Boost
    m_Metadata:
      m_Items: []
  - m_Id: 4225244228222976
    m_Localized: Allgemeine Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 4225273508659200
    m_Localized: Spieleinstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 5320637074636800
    m_Localized: Konflikt! Doppelte Tasten.
    m_Metadata:
      m_Items: []
  - m_Id: 6408009740713984
    m_Localized: Kannst keinen weiteren Treibstoff sammeln!
    m_Metadata:
      m_Items: []
  - m_Id: 6417898709975040
    m_Localized: "Spiel\xFCbersicht"
    m_Metadata:
      m_Items: []
  - m_Id: 6418067216138240
    m_Localized: "Springe mit Hilfe der im Weltraum verteilten, schwebenden Plattformen
      immer h\xF6her. \r\nDu springst automatisch und musst dich nach links oder
      rechts bewegen, um auf den oberen Plattformen zu landen. Verfehlst du eine
      Plattform und f\xE4llst aus dem Bildschirm oder kollidierst du von unten oder
      der Seite mit einem UFO, ist das Spiel vorbei. \r\nGelange so hoch wie m\xF6glich,
      um die h\xF6chste Punktzahl wie m\xF6glich zu erreichen.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 6418097113137152
    m_Localized: Bewegung
    m_Metadata:
      m_Items: []
  - m_Id: 6418170840612864
    m_Localized: "Neige dein Handy nach links und rechts, um dich auf die n\xE4chsten
      Plattformen zu bewegen."
    m_Metadata:
      m_Items: []
  - m_Id: 6418195234684928
    m_Localized: Raketen-Boost-Mechaniken
    m_Metadata:
      m_Items: []
  - m_Id: 6419343605760000
    m_Localized: "Deine Rakete erm\xF6glicht es dir, nach oben zu boosten. Falls
      Treibstoff im Tank ist, dr\xFCcke die Boost-Taste, um nach oben zu fliegen.
      Zum Auftanken ber\xFChre Treibstofftanks, die auf manchen Plattformen erscheinen.
      Rote Tanks f\xFCllen 20 % Treibstoff auf, blaue Tanks f\xFCllen deinen Tank
      vollst\xE4ndig.\nW\xE4hrend eines Boosts wird dein Treibstoff kontinuierlich
      verbraucht, aber jeder Boost verbraucht mindestens 20 % deines gesamten Tanks.
      Wenn du mit weniger als 20 % Treibstoff zu boosten beginnst, wird alles verbraucht.\nNutze
      Boosts, um verpasste Landungen zu korrigieren oder h\xF6here Plattformen zu
      erreichen."
    m_Metadata:
      m_Items: []
  - m_Id: 6418291280052224
    m_Localized: Plattformtypen
    m_Metadata:
      m_Items: []
  - m_Id: 6418301782589440
    m_Localized: "Plattformen gibt es in drei Varianten:\n- Gr\xFCn: Statisch und
      dauerhaft.\n- Lila: Bewegt sich konstant nach links und rechts.\n- Rot: Zerbricht
      nach einem Sprung \u2013 nur einmal nutzbar."
    m_Metadata:
      m_Items: []
  - m_Id: 6418419743195136
    m_Localized: UFO-Mechaniken
    m_Metadata:
      m_Items: []
  - m_Id: 6418451519242240
    m_Localized: "UFOs schweben langsam nach unten und verfolgen deine horizontale
      Position. Bevor ein UFO auf dem Bildschirm erscheint, zeigt ein Pfeil am oberen
      Rand an, aus welcher Richtung es kommt. Eine Kollision von unten oder von der
      Seite beendet deinen Lauf.\r\nDu kannst UFOs jedoch auf drei Arten vernichten:\r\n-
      Laserschuss: Ziele mit dem Joystick in Richtung deines Ziels und lasse ihn
      los. Ein Laserstrahl wird von deiner Position abgefeuert und zerst\xF6rt ein
      UFO, wenn er trifft.\r\n- Sprung: Springe auf ein UFO, um es zu zerst\xF6ren.
      Du prallst dabei wie auf einer Plattform auf.\r\n- Raketenschub: Fliege mit
      einem Boost gegen ein UFO, um es zu vernichten.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 6418570339680256
    m_Localized: Start-Boost
    m_Metadata:
      m_Items: []
  - m_Id: 6418695137001472
    m_Localized: "Ab einem Punktestand von 500 schaltest du beim n\xE4chsten Lauf
      einen automatischen Start-Boost frei, der dich bis zu 50\u202F% der H\xF6he
      deines letzten Spiels nach oben katapultiert. In den Einstellungen kannst du
      diese Funktion ein- oder ausschalten."
    m_Metadata:
      m_Items: []
  - m_Id: 6418716410511360
    m_Localized: Pause-Funktion
    m_Metadata:
      m_Items: []
  - m_Id: 6418756222844928
    m_Localized: "Pausiere das Spiel jederzeit \xFCber das Pausensymbol oben links."
    m_Metadata:
      m_Items: []
  - m_Id: 6418783104139264
    m_Localized: Spiel-UI
    m_Metadata:
      m_Items: []
  - m_Id: 6418846614290432
    m_Localized: "W\xE4hrend des Spiels siehst du auf der rechten Seite des Bildschirms
      stets:\r\n- Aktueller Punktestand: Deine aktuelle H\xF6he in Echtzeit.\r\n-
      Rekord: Die h\xF6chste H\xF6he, die du je erreicht hast. \n- Treibstoffvorrat:
      Dein verbleibender Raketentreibstoff.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6418875605319680
    m_Localized: "Einstellungen-Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 6418934363324416
    m_Localized: "\xD6ffne im Hauptmen\xFC das Einstellungsmen\xFC um:\r\n- Die Sprache
      der On-Screen-Texte zu w\xE4hlen\r\n- Die Lautst\xE4rke von Musik und Soundeffekten
      anzupassen\r\n- Die Position des Schuss-Joysticks und der Boost-Taste zu tauschen\r\n-
      Den automatischen Start-Boost und die In-Game-Tipps zu aktivieren/deaktivieren\r"
    m_Metadata:
      m_Items: []
  - m_Id: 6751468896911360
    m_Localized: "Fortschritt l\xF6schen?"
    m_Metadata:
      m_Items: []
  - m_Id: 6751719573684224
    m_Localized: "Bist du sicher, dass du alle dein Fortschritt l\xF6schen m\xF6chtest?
      Dies kann nicht r\xFCckg\xE4ngig gemacht werden."
    m_Metadata:
      m_Items: []
  - m_Id: 6751744198443008
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 6751820652216320
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 6751853573308416
    m_Localized: "L\xF6schen best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 6751933776789504
    m_Localized: "Dies l\xF6scht alle deine Erfolge unwiderruflich. Sie k\xF6nnen
      nicht wiederhergestellt werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 6751976357363712
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 6752012029919232
    m_Localized: "Alles l\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 6769556006633472
    m_Localized: "All dein Fortschritt wurde gel\xF6scht."
    m_Metadata:
      m_Items: []
  - m_Id: 6819690010640384
    m_Localized: "Fortschritt l\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 8591763389284352
    m_Localized: "In\u2011Game\u2011Tipps"
    m_Metadata:
      m_Items: []
  - m_Id: 8607735869341696
    m_Localized: "Sammle Treibstoff f\xFCr den Boost!"
    m_Metadata:
      m_Items: []
  - m_Id: 178533994857496576
    m_Localized: Skins
    m_Metadata:
      m_Items: []
  - m_Id: 180976597200797696
    m_Localized: 'Werbung ansehen

      zum Wiederbeleben'
    m_Metadata:
      m_Items: []
